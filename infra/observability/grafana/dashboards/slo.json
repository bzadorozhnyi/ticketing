{
  "uid": "slo",
  "title": "SLO",
  "description": "Error budgets and burn rates of the SLOs in infra/observability/rules/slo.yaml. See ADR 0006.",
  "tags": [
    "ticketing"
  ],
  "schemaVersion": 41,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "table",
      "title": "Firing alerts",
      "description": "Alerts of infra/observability/rules/slo.yaml; Prometheus evaluates them, nothing is sent anywhere.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "None firing"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (alertname, slo, job) (ALERTS{alertstate=\"firing\"})",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Catalog reads: 99.5 % of /api/v1/events requests without 5xx",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Good share, 30 days",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:browse_availability:error_ratio_rate30d",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error budget left, 30 days",
      "description": "1 - error ratio / error budget. Below 0 the objective is missed.",
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 4,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - slo:browse_availability:error_ratio_rate30d / slo:browse_availability:error_budget",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Burn rate by window",
      "description": "1 spends the budget in exactly 30 days. Pages: above 14.4 over 1 h and 5 m, or above 6 over 6 h and 30 m.",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "5m",
          "expr": "slo:browse_availability:error_ratio_rate5m / slo:browse_availability:error_budget",
          "legendFormat": "5m"
        },
        {
          "refId": "30m",
          "expr": "slo:browse_availability:error_ratio_rate30m / slo:browse_availability:error_budget",
          "legendFormat": "30m"
        },
        {
          "refId": "1h",
          "expr": "slo:browse_availability:error_ratio_rate1h / slo:browse_availability:error_budget",
          "legendFormat": "1h"
        },
        {
          "refId": "6h",
          "expr": "slo:browse_availability:error_ratio_rate6h / slo:browse_availability:error_budget",
          "legendFormat": "6h"
        }
      ]
    },

{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                $1::uuid AS \"hold_id!\",\n                event_id,\n                array_agg(seat_id ORDER BY seat_id) AS \"seat_ids!\",\n                min(expires_at) AS \"expires_at!\"\n            FROM holds\n            WHERE hold_id = $1 AND owner_id = $2\n            GROUP BY event_id\n            ",
